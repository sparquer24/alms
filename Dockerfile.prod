# Stage 1: Builder
FROM node:22-alpine AS builder

# Set working directory
WORKDIR /app

# Copy root package files and install all monorepo dependencies
# This includes backend, frontend, and root dependencies.
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

# Use 'npm ci' for faster, more reliable builds in CI/CD environments
RUN npm ci

# Copy the rest of the monorepo source code
COPY . .

# Set the working directory to the frontend workspace
WORKDIR /app/frontend

# Build the Next.js application
# This command now runs in the context of the frontend workspace
RUN npm run build

# Stage 2: Production Runner
FROM node:22-alpine AS runner
WORKDIR /app

# Copy the static export from the builder stage
COPY --from=builder /app/frontend/out ./

# Expose port 3000 to be served by a static server
EXPOSE 3000

# Use 'npx serve' to run the static site. It's simple and effective.
CMD ["npx", "serve", "-s", "."]