# Production Dockerfile for NestJS backend
# Builds the app, generates Prisma client, and runs the compiled output with node
FROM node:22-alpine AS builder
WORKDIR /app

# Copy package files first so npm install layer is cached when source changes
COPY package*.json ./

# Install build tools and dependencies (including devDependencies required for build)
# dl-cdn.alpinelinux.org is flaky ("TLS: unspecified error"), so retry the apk call
RUN for i in 1 2 3 4 5; do \
        apk add --no-cache --virtual .build-deps python3 make g++ gcc libc-dev linux-headers git \
        && break \
        || { echo "apk add failed (attempt $i/5), retrying in 5s..."; sleep 5; }; \
    done \
    && (npm ci --include=dev || npm ci --production=false || npm install) \
    && npm install typescript --no-save \
    && (apk del .build-deps || true)

# Copy application source after dependencies to maximize cache hits
COPY . .

# Generate Prisma client before building so TypeScript can import generated types
RUN npx prisma generate || true
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Install wget for health checks (retry: Alpine CDN is flaky and often fails with TLS errors)
# Note: busybox already ships a wget applet in Alpine, so this line could be dropped entirely
RUN for i in 1 2 3 4 5; do \
        apk add --no-cache wget \
        && break \
        || { echo "apk add failed (attempt $i/5), retrying in 5s..."; sleep 5; }; \
    done

# Keep package metadata (node_modules will be copied from builder)
COPY package*.json ./

# Copy built files and prisma client
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma

# Copy entrypoint: applies pending prisma migrations before the app starts.
# Normalize line endings (repo is edited on Windows) so the shebang resolves.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN apk add --no-cache dos2unix \
    && dos2unix /usr/local/bin/docker-entrypoint.sh \
    && apk del dos2unix \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

# Use PORT from environment (defaults to 3000 if not set)
EXPOSE 3001

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/main.js"]
