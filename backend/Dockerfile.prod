# Production Dockerfile for NestJS backend
# Optimized for Docker layer caching
#
# Layer invalidation order (least → most frequently changing):
#   1. System packages (apk)
#   2. package.json / lockfile
#   3. Prisma schema
#   4. tsconfig, nest config
#   5. Source code

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

# Layer 1: Install system build deps (rarely changes)
RUN apk add --no-cache --virtual .build-deps python3 make g++ gcc libc-dev linux-headers git

# Layer 2: Install Node dependencies (cached until package.json or lockfile changes)
COPY package*.json ./
RUN npm install && apk del .build-deps

# Layer 3: Copy Prisma schema and generate client (cached unless schema changes)
COPY prisma/ ./prisma/
RUN npx prisma generate

# Layer 4: Copy config files that affect the build (cached unless changed)
COPY tsconfig*.json ./

# Layer 5: Copy application source (changes most frequently — latest layer)
COPY src/ ./src/

# Layer 6: Build the app
RUN npm run build

# ── Stage 2: Runner ───────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Layer 1: Install runtime utilities (rarely changes)
RUN apk add --no-cache wget

# Layer 2: Copy only production node_modules from builder
COPY --from=builder /app/node_modules ./node_modules

# Layer 3: Copy built artifacts
COPY --from=builder /app/dist ./dist

# Layer 4: Copy Prisma client (needed at runtime for queries)
COPY --from=builder /app/prisma ./prisma

EXPOSE 3001

CMD ["sh", "-c", "node dist/main.js"]
