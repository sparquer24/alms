model Hearings {
  id                 Int                                     @id @default(autoincrement())
  applicationId      Int?
  renewalId          Int?
  scheduledBy        Int
  hearingType        String
  location           String
  noticeNumber       String?
  hearingDate        DateTime
  decision           String?
  attendanceStatus   String?
