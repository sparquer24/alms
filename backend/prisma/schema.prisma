generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Statuses {
  id                  Int                                      @id @default(autoincrement())
  code                String                                   @unique
  name                String
  description         String?
  isActive            Boolean                                  @default(true)
  createdAt           DateTime                                 @default(now())
  updatedAt           DateTime                                 @updatedAt
  isStarted           Boolean                                  @default(false)
  cancelFormRequests  CancelFormRequests[]                     @relation("CancelFormWorkflowStatus")
  applications        FreshLicenseApplicationPersonalDetails[] @relation("ApplicationWorkflowStatus")
  renewalApplications RenewalFormPersonalDetails[]             @relation("RenewalApplicationWorkflowStatus")
}

model Actiones {
  id                         Int                                             @id @default(autoincrement())
  code                       String                                          @unique
  name                       String
  description                String?
  isActive                   Boolean                                         @default(true)
  createdAt                  DateTime                                        @default(now())
  updatedAt                  DateTime                                        @updatedAt
  cancelWorkflowHistories    CancelWorkflowHistories[]                       @relation("CancelActionesToWorkflowHistory")
  applicationsHistory        FreshLicenseApplicationsFormWorkflowHistories[] @relation("ActionesToWorkflowHistory")
  renewalApplicationsHistory RenewalApplicationsFormWorkflowHistories[]      @relation("RenewalActionesToWorkflowHistory")
  rolesActionsMapping        RolesActionsMapping[]
}

model States {
  id                 Int                                 @id @default(autoincrement())
  name               String                              @unique
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  districts          Districts[]
  addresses          FLAFAddressesAndContactDetails[]
  occupations        FLAFOccupationAndBusiness[]
  renewalAddresses   RenewalAddressesAndContactDetails[]
  renewalOccupations RenewalOccupationAndBusiness[]
  users              Users[]                             @relation("StateUsers")
}

model Districts {
  id                 Int                                 @id @default(autoincrement())
  name               String                              @unique
  stateId            Int
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  state              States                              @relation(fields: [stateId], references: [id], onDelete: Cascade)
  addresses          FLAFAddressesAndContactDetails[]
  occupations        FLAFOccupationAndBusiness[]
  RangeOffices       RangeOffices[]
  renewalAddresses   RenewalAddressesAndContactDetails[]
  renewalOccupations RenewalOccupationAndBusiness[]
  users              Users[]                             @relation("DistrictUsers")
}

model Zones {
  id               Int                                 @id @default(autoincrement())
  name             String                              @unique
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  rangeOfficeId    Int?
  divisions        Divisions[]
  addresses        FLAFAddressesAndContactDetails[]
  renewalAddresses RenewalAddressesAndContactDetails[]
  users            Users[]                             @relation("ZoneUsers")
  RangeOffices     RangeOffices?                       @relation(fields: [rangeOfficeId], references: [id], onDelete: Cascade)
}

model Divisions {
  id               Int                                 @id @default(autoincrement())
  name             String                              @unique
  zoneId           Int
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  zone             Zones                               @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  addresses        FLAFAddressesAndContactDetails[]
  stations         PoliceStations[]
  renewalAddresses RenewalAddressesAndContactDetails[]
  users            Users[]                             @relation("DivisionUsers")
}

model PoliceStations {
  id               Int                                 @id @default(autoincrement())
  name             String                              @unique
  divisionId       Int
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  addresses        FLAFAddressesAndContactDetails[]
  division         Divisions                           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  renewalAddresses RenewalAddressesAndContactDetails[]
  users            Users[]                             @relation("PoliceStationUsers")
}

model Roles {
  id                             Int                                             @id @default(autoincrement())
  code                           String                                          @unique
  name                           String
  is_active                      Boolean                                         @default(true)
  created_at                     DateTime                                        @default(now())
  updated_at                     DateTime                                        @updatedAt
  dashboard_title                String
  menu_items                     Json?
  permissions                    Json?
  can_access_settings            Boolean                                         @default(false)
  can_forward                    Boolean                                         @default(false)
  can_re_enquiry                 Boolean                                         @default(false)
  can_generate_ground_report     Boolean                                         @default(false)
  can_FLAF                       Boolean                                         @default(false)
  can_create_freshLicence        Boolean                                         @default(false)
  cancelWorkflowHistoryNext      CancelWorkflowHistories[]                       @relation("CancelWorkflowNextRole")
  cancelWorkflowHistoryPrevious  CancelWorkflowHistories[]                       @relation("CancelWorkflowPreviousRole")
  workflowHistoryNext            FreshLicenseApplicationsFormWorkflowHistories[] @relation("WorkflowNextRole")
  workflowHistoryPrevious        FreshLicenseApplicationsFormWorkflowHistories[] @relation("WorkflowPreviousRole")
  renewalWorkflowHistoryNext     RenewalApplicationsFormWorkflowHistories[]      @relation("RenewalWorkflowNextRole")
  renewalWorkflowHistoryPrevious RenewalApplicationsFormWorkflowHistories[]      @relation("RenewalWorkflowPreviousRole")
  currentRoleFlowMappings        RoleFlowMapping?                                @relation("CurrentRole")
  rolesActionsMapping            RolesActionsMapping[]
  users                          Users[]
}

model RolesActionsMapping {
  id        Int      @id @default(autoincrement())
  roleId    Int
  actionId  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  action    Actiones @relation(fields: [actionId], references: [id], onDelete: Cascade)
  role      Roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, actionId])
}

model RoleFlowMapping {
  id            Int      @id @default(autoincrement())
  currentRoleId Int      @unique
  nextRoleIds   Int[]
  updatedBy     Int?
  updatedAt     DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())
  currentRole   Roles    @relation("CurrentRole", fields: [currentRoleId], references: [id], onDelete: Cascade)
  updatedByUser Users?   @relation(fields: [updatedBy], references: [id])
}

model WeaponTypeMaster {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique
  description           String?
  imageUrl              String?
  renewalLicenseDetails RenewalLicenseDetails[] @relation("RenewalRequestedWeapons")
  licenseDetails        FLAFLicenseDetails[]    @relation("RequestedWeapons")
  licenseEndorsements   Licenses[]              @relation("LicenseEndorsedWeapons")
}

model Users {
  id                             Int                                             @id @default(autoincrement())
  username                       String
  email                          String?                                         @unique
  password                       String
  createdAt                      DateTime                                        @default(now())
  updatedAt                      DateTime                                        @updatedAt
  phoneNo                        String?                                         @unique
  roleId                         Int
  policeStationId                Int?
  stateId                        Int?
  districtId                     Int?
  zoneId                         Int?
  divisionId                     Int?
  rangeOfficeId                  Int?
  actionsFrom                    ActionHistories[]                               @relation("ActionFromUser")
  actionsTo                      ActionHistories[]                               @relation("ActionToUser")
  cancelRequestActioners         CancelFormRequests[]                            @relation("CancelRequestActioner")
  cancelRequestCurrentUsers      CancelFormRequests[]                            @relation("CancelFormCurrentUser")
  cancelRequestPreviousUsers     CancelFormRequests[]                            @relation("CancelFormPreviousUser")
  cancelRequestRequesters        CancelFormRequests[]                            @relation("CancelRequestRequester")
  cancelWorkflowHistoryNext      CancelWorkflowHistories[]                       @relation("CancelWorkflowNextUser")
  cancelWorkflowHistoryPrevious  CancelWorkflowHistories[]                       @relation("CancelWorkflowPreviousUser")
  flowMaps                       FlowMaps[]
  nextUserInFlows                FlowNextUsers[]                                 @relation("NextUserInFlow")
  currentApplications            FreshLicenseApplicationPersonalDetails[]        @relation("CurrentApplicationOwner")
  previousApplications           FreshLicenseApplicationPersonalDetails[]        @relation("PreviousApplicationOwner")
  workflowHistoryNext            FreshLicenseApplicationsFormWorkflowHistories[] @relation("WorkflowNextUser")
  workflowHistoryPrevious        FreshLicenseApplicationsFormWorkflowHistories[] @relation("WorkflowPreviousUser")
  mergeAuditLogs                 LicensesMergeAuditLog[]                         @relation("MergeAuditLogUser")
  renewalWorkflowHistoryNext     RenewalApplicationsFormWorkflowHistories[]      @relation("RenewalWorkflowNextUser")
  renewalWorkflowHistoryPrevious RenewalApplicationsFormWorkflowHistories[]      @relation("RenewalWorkflowPreviousUser")
  renewalCurrentApplications     RenewalFormPersonalDetails[]                    @relation("RenewalCurrentApplicationOwner")
  renewalPreviousApplications    RenewalFormPersonalDetails[]                    @relation("RenewalPreviousApplicationOwner")
  flowMappingUpdates             RoleFlowMapping[]
  district                       Districts?                                      @relation("DistrictUsers", fields: [districtId], references: [id], onDelete: Cascade)
  division                       Divisions?                                      @relation("DivisionUsers", fields: [divisionId], references: [id], onDelete: Cascade)
  policeStation                  PoliceStations?                                 @relation("PoliceStationUsers", fields: [policeStationId], references: [id], onDelete: Cascade)
  RangeOffices                   RangeOffices?                                   @relation(fields: [rangeOfficeId], references: [id], onDelete: Cascade)
  role                           Roles                                           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  state                          States?                                         @relation("StateUsers", fields: [stateId], references: [id], onDelete: Cascade)
  zone                           Zones?                                          @relation("ZoneUsers", fields: [zoneId], references: [id], onDelete: Cascade)
  issuedLicenses                 Licenses[]                                      @relation("IssuedLicenses")
  licenseWorkflowChanges        LicenseWorkflowHistory[]                        @relation("LicenseWorkflowChangedBy")
  auditLogs                      AuditLogs[]                                     @relation("UserAuditLogs")
  policeReports                  PoliceEnquiryReports[]                          @relation("OfficerPoliceReports")
  scheduledHearings              Hearings[]                                      @relation("ScheduledHearings")
}

model FlowMaps {
  id            Int               @id @default(autoincrement())
  currentUserId Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  actions       ActionHistories[]
  currentUser   Users             @relation(fields: [currentUserId], references: [id], onDelete: Cascade)
  nextUsers     FlowNextUsers[]
}

model FlowNextUsers {
  id         Int      @id @default(autoincrement())
  flowMapId  Int
  nextUserId Int
  flowMap    FlowMaps @relation(fields: [flowMapId], references: [id], onDelete: Cascade)
  nextUser   Users    @relation("NextUserInFlow", fields: [nextUserId], references: [id], onDelete: Cascade)
}

model ActionHistories {
  id          Int      @id @default(autoincrement())
  flowMapId   Int
  fromUserId  Int
  toUserId    Int
  actionTaken String
  createdAt   DateTime @default(now())
  flowMap     FlowMaps @relation(fields: [flowMapId], references: [id], onDelete: Cascade)
  fromUser    Users    @relation("ActionFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      Users    @relation("ActionToUser", fields: [toUserId], references: [id], onDelete: Cascade)
}

model FreshLicenseApplicationPersonalDetails {
  id                         Int                                             @id @default(autoincrement())
  acknowledgementNo          String?
  firstName                  String
  middleName                 String?
  lastName                   String
  parentOrSpouseName         String
  sex                        Sex
  placeOfBirth               String?
  dateOfBirth                DateTime?
  dobInWords                 String?
  panNumber                  String?
  aadharNumber               String?
  createdAt                  DateTime                                        @default(now())
  updatedAt                  DateTime                                        @default(now()) @updatedAt
  filledBy                   String?
  occupationAndBusinessId    Int?
  permanentAddressId         Int?
  presentAddressId           Int?
  currentUserId              Int?
  previousUserId             Int?
  workflowStatusId           Int?
  isAwareOfLegalConsequences Boolean?                                        @default(false)
  isDeclarationAccepted      Boolean?                                        @default(false)
  isTermsAccepted            Boolean?                                        @default(false)
  isSubmit                   Boolean?                                        @default(false)
  almsLicenseId              String?
  isApproved                 Boolean?                                        @default(false)
  isFLAFGenerated            Boolean?                                        @default(false)
  isGroundReportGenerated    Boolean?                                        @default(false)
  isPending                  Boolean?                                        @default(false)
  isReEnquiry                Boolean?                                        @default(false)
  isReEnquiryDone            Boolean?                                        @default(false)
  isRejected                 Boolean?                                        @default(false)
  isNotRecommended           Boolean?                                        @default(false)
  isRecommended              Boolean?                                        @default(false)
  aliasPotalNumber           String?
  cancelFormRequests         CancelFormRequests[]                            @relation("FreshLicenseCancelLog")
  biometricData              FLAFBiometricDatas?                             @relation("BiometricData")
  criminalHistories          FLAFCriminalHistories[]                         @relation("CriminalHistories")
  fileUploads                FLAFFileUploads[]                               @relation("FileUploads")
  licenseDetails             FLAFLicenseDetails[]                            @relation("LicenseDetails")
  licenseHistories           FLAFLicenseHistories[]                          @relation("LicenseHistories")
  currentUser                Users?                                          @relation("CurrentApplicationOwner", fields: [currentUserId], references: [id], onDelete: Cascade)
  occupationAndBusiness      FLAFOccupationAndBusiness?                      @relation("occupationAndBusinessId", fields: [occupationAndBusinessId], references: [id], onDelete: Cascade)
  permanentAddress           FLAFAddressesAndContactDetails?                 @relation("PermanentAddress", fields: [permanentAddressId], references: [id], onDelete: Cascade)
  presentAddress             FLAFAddressesAndContactDetails?                 @relation("PresentAddress", fields: [presentAddressId], references: [id], onDelete: Cascade)
  previousUser               Users?                                          @relation("PreviousApplicationOwner", fields: [previousUserId], references: [id], onDelete: Cascade)
  workflowStatus             Statuses?                                       @relation("ApplicationWorkflowStatus", fields: [workflowStatusId], references: [id], onDelete: Cascade)
  workflowHistories          FreshLicenseApplicationsFormWorkflowHistories[] @relation("WorkflowHistories")
  mergeAuditLogs             LicensesMergeAuditLog[]                         @relation("FreshLicenseMergeLog")
  renewalFormPersonalDetails RenewalFormPersonalDetails[]                    @relation("FreshLicenseRenewalLink")
  sourceLicense              Licenses?                                       @relation("LicenseSourceFresh")
  policeReports              PoliceEnquiryReports[]                          @relation("FreshPoliceReports")
  hearings                   Hearings[]                                      @relation("FreshHearings")

  @@index([aadharNumber])
  @@index([workflowStatusId])
  @@index([currentUserId])
  @@index([createdAt])
}

model FLAFAddressesAndContactDetails {
  id                    Int                                      @id @default(autoincrement())
  addressLine           String
  stateId               Int
  districtId            Int
  policeStationId       Int
  sinceResiding         DateTime
  divisionId            Int
  zoneId                Int
  telephoneOffice       String?
  telephoneResidence    String?
  officeMobileNumber    String?
  alternativeMobile     String?
  rangeOfficeId         Int?
  district              Districts                                @relation(fields: [districtId], references: [id], onDelete: Cascade)
  division              Divisions                                @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  policeStation         PoliceStations                           @relation(fields: [policeStationId], references: [id], onDelete: Cascade)
  RangeOffices          RangeOffices?                            @relation(fields: [rangeOfficeId], references: [id], onDelete: Cascade)
  state                 States                                   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  zone                  Zones                                    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  permanentApplications FreshLicenseApplicationPersonalDetails[] @relation("PermanentAddress")
  presentApplications   FreshLicenseApplicationPersonalDetails[] @relation("PresentAddress")
}

model FLAFOccupationAndBusiness {
  id                   Int                                      @id @default(autoincrement())
  occupation           String
  officeAddress        String
  stateId              Int
  districtId           Int
  cropLocation         String?
  areaUnderCultivation Float?
  district             Districts                                @relation(fields: [districtId], references: [id], onDelete: Cascade)
  state                States                                   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  applications         FreshLicenseApplicationPersonalDetails[] @relation("occupationAndBusinessId")
}

model FLAFCriminalHistories {
  id                Int                                    @id @default(autoincrement())
  applicationId     Int
  isConvicted       Boolean                                @default(false)
  isBondExecuted    Boolean                                @default(false)
  bondDate          DateTime?
  bondPeriod        String?
  isProhibited      Boolean                                @default(false)
  prohibitionDate   DateTime?
  prohibitionPeriod String?
  createdAt         DateTime                               @default(now())
  updatedAt         DateTime                               @updatedAt
  firDetails        Json?
  application       FreshLicenseApplicationPersonalDetails @relation("CriminalHistories", fields: [applicationId], references: [id], onDelete: Cascade)
}

model FLAFLicenseHistories {
  id                      Int                                    @id @default(autoincrement())
  applicationId           Int
  hasAppliedBefore        Boolean                                @default(false)
  dateAppliedFor          DateTime?
  previousAuthorityName   String?
  previousResult          LicenseResult?
  hasLicenceSuspended     Boolean                                @default(false)
  suspensionAuthorityName String?
  suspensionReason        String?
  hasFamilyLicence        Boolean                                @default(false)
  familyMemberName        String?
  familyLicenceNumber     String?
  familyWeaponsEndorsed   String[]
  hasSafePlace            Boolean                                @default(false)
  safePlaceDetails        String?
  hasTraining             Boolean                                @default(false)
  trainingDetails         String?
  createdAt               DateTime                               @default(now())
  updatedAt               DateTime                               @updatedAt
  application             FreshLicenseApplicationPersonalDetails @relation("LicenseHistories", fields: [applicationId], references: [id], onDelete: Cascade)
}

model FLAFLicenseDetails {
  id                         Int                                    @id @default(autoincrement())
  applicationId              Int
  needForLicense             LicensePurpose?
  armsCategory               ArmsCategory?
  areaOfValidity             String?
  ammunitionDescription      String?
  specialConsiderationReason String?
  licencePlaceArea           String?
  wildBeastsSpecification    String?
  createdAt                  DateTime                               @default(now())
  updatedAt                  DateTime                               @updatedAt
  application                FreshLicenseApplicationPersonalDetails @relation("LicenseDetails", fields: [applicationId], references: [id], onDelete: Cascade)
  requestedWeapons           WeaponTypeMaster[]                     @relation("RequestedWeapons")
}

model FLAFFileUploads {
  id            Int                                    @id @default(autoincrement())
  applicationId Int
  fileType      FileType
  fileUrl       String
  uploadedAt    DateTime                               @default(now())
  fileName      String
  fileSize      Int
  application   FreshLicenseApplicationPersonalDetails @relation("FileUploads", fields: [applicationId], references: [id], onDelete: Cascade)
}

model FLAFBiometricDatas {
  id            Int                                    @id @default(autoincrement())
  applicationId Int                                    @unique
  biometricData Json
  application   FreshLicenseApplicationPersonalDetails @relation("BiometricData", fields: [applicationId], references: [id], onDelete: Cascade)
}

model FreshLicenseApplicationsFormWorkflowHistories {
  id             Int                                    @id @default(autoincrement())
  applicationId  Int
  previousUserId Int
  nextUserId     Int
  actionTaken    String
  remarks        String?
  createdAt      DateTime                               @default(now())
  previousRoleId Int?
  nextRoleId     Int?
  actionesId     Int?
  attachments    Json?
  actiones       Actiones?                              @relation("ActionesToWorkflowHistory", fields: [actionesId], references: [id], onDelete: Cascade)
  application    FreshLicenseApplicationPersonalDetails @relation("WorkflowHistories", fields: [applicationId], references: [id], onDelete: Cascade)
  nextRole       Roles?                                 @relation("WorkflowNextRole", fields: [nextRoleId], references: [id], onDelete: Cascade)
  nextUser       Users                                  @relation("WorkflowNextUser", fields: [nextUserId], references: [id], onDelete: Cascade)
  previousRole   Roles?                                 @relation("WorkflowPreviousRole", fields: [previousRoleId], references: [id], onDelete: Cascade)
  previousUser   Users                                  @relation("WorkflowPreviousUser", fields: [previousUserId], references: [id], onDelete: Cascade)
}

model RenewalFormPersonalDetails {
  id                                     Int                                        @id @default(autoincrement())
  acknowledgementNo                      String?
  licenseNumber                          String                                     @unique
  firstName                              String
  middleName                             String?
  lastName                               String
  parentOrSpouseName                     String
  sex                                    Sex
  dateOfBirth                            DateTime?
  dobInWords                             String?
  panNumber                              String?
  aadharNumber                           String?
  createdAt                              DateTime                                   @default(now())
  updatedAt                              DateTime                                   @updatedAt
  filledBy                               String?
  occupationAndBusinessId                Int?
  permanentAddressId                     Int?
  presentAddressId                       Int?
  currentUserId                          Int?
  previousUserId                         Int?
  workflowStatusId                       Int?
  isAwareOfLegalConsequences             Boolean?                                   @default(false)
  isDeclarationAccepted                  Boolean?                                   @default(false)
  isTermsAccepted                        Boolean?                                   @default(false)
  isSubmit                               Boolean?                                   @default(false)
  renewalLicenseId                       String?
  isApproved                             Boolean?                                   @default(false)
  isGroundReportGenerated                Boolean?                                   @default(false)
  isPending                              Boolean?                                   @default(false)
  isReEnquiry                            Boolean?                                   @default(false)
  isReEnquiryDone                        Boolean?                                   @default(false)
  isRejected                             Boolean?                                   @default(false)
  isRecommended                          Boolean?                                   @default(false)
  isNotRecommended                       Boolean?                                   @default(false)
  freshLicenseId                         Int?
  mergeAuditLogs                         LicensesMergeAuditLog[]                    @relation("RenewalLicenseMergeLog")
  workflowHistories                      RenewalApplicationsFormWorkflowHistories[] @relation("RenewalWorkflowHistories")
  biometricData                          RenewalBiometricDatas?                     @relation("RenewalBiometricData")
  criminalHistories                      RenewalCriminalHistories[]                 @relation("RenewalCriminalHistories")
  fileUploads                            RenewalFileUploads[]                       @relation("RenewalFileUploads")
  currentUser                            Users?                                     @relation("RenewalCurrentApplicationOwner", fields: [currentUserId], references: [id], onDelete: Cascade)
  FreshLicenseApplicationPersonalDetails FreshLicenseApplicationPersonalDetails?    @relation("FreshLicenseRenewalLink", fields: [freshLicenseId], references: [id], onDelete: Cascade)
  occupationAndBusiness                  RenewalOccupationAndBusiness?              @relation("RenewalOccupationAndBusinessId", fields: [occupationAndBusinessId], references: [id], onDelete: Cascade)
  permanentAddress                       RenewalAddressesAndContactDetails?         @relation("RenewalPermanentAddress", fields: [permanentAddressId], references: [id], onDelete: Cascade)
  presentAddress                         RenewalAddressesAndContactDetails?         @relation("RenewalPresentAddress", fields: [presentAddressId], references: [id], onDelete: Cascade)
  previousUser                           Users?                                     @relation("RenewalPreviousApplicationOwner", fields: [previousUserId], references: [id], onDelete: Cascade)
  workflowStatus                         Statuses?                                  @relation("RenewalApplicationWorkflowStatus", fields: [workflowStatusId], references: [id], onDelete: Cascade)
  licenseDetails                         RenewalLicenseDetails[]                    @relation("RenewalLicenseDetails")
  licenseHistories                       RenewalLicenseHistories[]                  @relation("RenewalLicenseHistories")
  policeReports                          PoliceEnquiryReports[]                     @relation("RenewalPoliceReports")
  hearings                               Hearings[]                                 @relation("RenewalHearings")

  @@index([aadharNumber])
  @@index([licenseNumber])
  @@index([workflowStatusId])
  @@index([currentUserId])
  @@index([createdAt])
}

model RenewalAddressesAndContactDetails {
  id                    Int                          @id @default(autoincrement())
  addressLine           String
  stateId               Int
  districtId            Int
  policeStationId       Int
  sinceResiding         DateTime
  divisionId            Int
  zoneId                Int
  telephoneOffice       String?
  telephoneResidence    String?
  officeMobileNumber    String?
  alternativeMobile     String?
  rangeOfficeId         Int?
  district              Districts                    @relation(fields: [districtId], references: [id], onDelete: Cascade)
  division              Divisions                    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  policeStation         PoliceStations               @relation(fields: [policeStationId], references: [id], onDelete: Cascade)
  RangeOffices          RangeOffices?                @relation(fields: [rangeOfficeId], references: [id], onDelete: Cascade)
  state                 States                       @relation(fields: [stateId], references: [id], onDelete: Cascade)
  zone                  Zones                        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  permanentApplications RenewalFormPersonalDetails[] @relation("RenewalPermanentAddress")
  presentApplications   RenewalFormPersonalDetails[] @relation("RenewalPresentAddress")
}

model RenewalOccupationAndBusiness {
  id                   Int                          @id @default(autoincrement())
  occupation           String
  officeAddress        String
  stateId              Int
  districtId           Int
  cropLocation         String?
  areaUnderCultivation Float?
  applications         RenewalFormPersonalDetails[] @relation("RenewalOccupationAndBusinessId")
  district             Districts                    @relation(fields: [districtId], references: [id], onDelete: Cascade)
  state                States                       @relation(fields: [stateId], references: [id], onDelete: Cascade)
}

model RenewalLicenseDetails {
  id                         Int                        @id @default(autoincrement())
  applicationId              Int
  needForLicense             LicensePurpose?
  armsCategory               ArmsCategory?
  areaOfValidity             String?
  ammunitionDescription      String?
  specialConsiderationReason String?
  licencePlaceArea           String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  application                RenewalFormPersonalDetails @relation("RenewalLicenseDetails", fields: [applicationId], references: [id], onDelete: Cascade)
  requestedWeapons           WeaponTypeMaster[]         @relation("RenewalRequestedWeapons")
}

model RenewalFileUploads {
  id            Int                        @id @default(autoincrement())
  applicationId Int
  fileType      FileType
  fileUrl       String
  uploadedAt    DateTime                   @default(now())
  fileName      String
  fileSize      Int
  application   RenewalFormPersonalDetails @relation("RenewalFileUploads", fields: [applicationId], references: [id], onDelete: Cascade)
}

model RenewalBiometricDatas {
  id            Int                        @id @default(autoincrement())
  applicationId Int                        @unique
  biometricData Json
  application   RenewalFormPersonalDetails @relation("RenewalBiometricData", fields: [applicationId], references: [id], onDelete: Cascade)
}

model RenewalCriminalHistories {
  id                Int                        @id @default(autoincrement())
  applicationId     Int
  isConvicted       Boolean                    @default(false)
  isBondExecuted    Boolean                    @default(false)
  bondDate          DateTime?
  bondPeriod        String?
  isProhibited      Boolean                    @default(false)
  prohibitionDate   DateTime?
  prohibitionPeriod String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  firDetails        Json?
  application       RenewalFormPersonalDetails @relation("RenewalCriminalHistories", fields: [applicationId], references: [id], onDelete: Cascade)
}

model RenewalLicenseHistories {
  id                      Int                        @id @default(autoincrement())
  applicationId           Int
  hasAppliedBefore        Boolean                    @default(false)
  dateAppliedFor          DateTime?
  previousAuthorityName   String?
  previousResult          LicenseResult?
  hasLicenceSuspended     Boolean                    @default(false)
  suspensionAuthorityName String?
  suspensionReason        String?
  hasFamilyLicence        Boolean                    @default(false)
  familyMemberName        String?
  familyLicenceNumber     String?
  familyWeaponsEndorsed   String[]
  hasSafePlace            Boolean                    @default(false)
  safePlaceDetails        String?
  hasTraining             Boolean                    @default(false)
  trainingDetails         String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  application             RenewalFormPersonalDetails @relation("RenewalLicenseHistories", fields: [applicationId], references: [id], onDelete: Cascade)
}

model RenewalApplicationsFormWorkflowHistories {
  id             Int                        @id @default(autoincrement())
  applicationId  Int
  previousUserId Int
  nextUserId     Int
  actionTaken    String
  remarks        String?
  createdAt      DateTime                   @default(now())
  previousRoleId Int?
  nextRoleId     Int?
  actionesId     Int?
  attachments    Json?
  actiones       Actiones?                  @relation("RenewalActionesToWorkflowHistory", fields: [actionesId], references: [id], onDelete: Cascade)
  application    RenewalFormPersonalDetails @relation("RenewalWorkflowHistories", fields: [applicationId], references: [id], onDelete: Cascade)
  nextRole       Roles?                     @relation("RenewalWorkflowNextRole", fields: [nextRoleId], references: [id], onDelete: Cascade)
  nextUser       Users                      @relation("RenewalWorkflowNextUser", fields: [nextUserId], references: [id], onDelete: Cascade)
  previousRole   Roles?                     @relation("RenewalWorkflowPreviousRole", fields: [previousRoleId], references: [id], onDelete: Cascade)
  previousUser   Users                      @relation("RenewalWorkflowPreviousUser", fields: [previousUserId], references: [id], onDelete: Cascade)
}

model LicensesMergeAuditLog {
  id               Int                                    @id @default(autoincrement())
  mergeId          String                                 @unique
  freshLicenseId   Int
  renewalLicenseId Int
  mergedFields     String?
  mergedBy         Int?
  mergedAt         DateTime                               @default(now())
  status           String                                 @default("COMPLETED")
  remarks          String?
  createdAt        DateTime                               @default(now())
  freshLicense     FreshLicenseApplicationPersonalDetails @relation("FreshLicenseMergeLog", fields: [freshLicenseId], references: [id], onDelete: Cascade)
  mergedByUser     Users?                                 @relation("MergeAuditLogUser", fields: [mergedBy], references: [id])
  renewalLicense   RenewalFormPersonalDetails             @relation("RenewalLicenseMergeLog", fields: [renewalLicenseId], references: [id], onDelete: Cascade)

  @@index([freshLicenseId])
  @@index([renewalLicenseId])
  @@index([mergeId])
}

model CancelFormRequests {
  id                      Int                                     @id @default(autoincrement())
  applicationType         String
  cancellationReason      String
  remarks                 String?
  status                  String                                  @default("PENDING")
  requestedBy             Int
  requestedDate           DateTime                                @default(now())
  actionedBy              Int?
  actionedDate            DateTime?
  currentUserId           Int?
  previousUserId          Int?
  workFlowStatusId        Int?
  createdAt               DateTime                                @default(now())
  updatedAt               DateTime                                @updatedAt
  freshLicenseId          Int?
  actioner                Users?                                  @relation("CancelRequestActioner", fields: [actionedBy], references: [id])
  currentUser             Users?                                  @relation("CancelFormCurrentUser", fields: [currentUserId], references: [id])
  freshLicense            FreshLicenseApplicationPersonalDetails? @relation("FreshLicenseCancelLog", fields: [freshLicenseId], references: [id], onDelete: Cascade)
  previousUser            Users?                                  @relation("CancelFormPreviousUser", fields: [previousUserId], references: [id])
  requester               Users                                   @relation("CancelRequestRequester", fields: [requestedBy], references: [id])
  workflowStatus          Statuses?                               @relation("CancelFormWorkflowStatus", fields: [workFlowStatusId], references: [id])
  cancelWorkflowHistories CancelWorkflowHistories[]               @relation("CancelWorkflowHistories")

  @@index([workFlowStatusId])
  @@index([currentUserId])
  @@index([createdAt])
  @@index([freshLicenseId])
}

model CancelWorkflowHistories {
  id             Int                @id @default(autoincrement())
  applicationId  Int
  previousUserId Int
  nextUserId     Int
  actionTaken    String
  remarks        String?
  createdAt      DateTime           @default(now())
  previousRoleId Int?
  nextRoleId     Int?
  actionesId     Int?
  attachments    Json?
  actiones       Actiones?          @relation("CancelActionesToWorkflowHistory", fields: [actionesId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cancel_workflow_actiones")
  application    CancelFormRequests @relation("CancelWorkflowHistories", fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cancel_workflow_application")
  nextRole       Roles?             @relation("CancelWorkflowNextRole", fields: [nextRoleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cancel_workflow_next_role")
  nextUser       Users              @relation("CancelWorkflowNextUser", fields: [nextUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cancel_workflow_next_user")
  previousRole   Roles?             @relation("CancelWorkflowPreviousRole", fields: [previousRoleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cancel_workflow_previous_role")
  previousUser   Users              @relation("CancelWorkflowPreviousUser", fields: [previousUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cancel_workflow_previous_user")

  @@index([actionesId], map: "idx_cancel_workflow_actionesId")
  @@index([applicationId], map: "idx_cancel_workflow_applicationId")
  @@index([nextRoleId], map: "idx_cancel_workflow_nextRoleId")
  @@index([nextUserId], map: "idx_cancel_workflow_nextUserId")
  @@index([previousRoleId], map: "idx_cancel_workflow_previousRoleId")
  @@index([previousUserId], map: "idx_cancel_workflow_previousUserId")
}

model RangeOffices {
  id                                Int                                 @id @default(autoincrement())
  name                              String                              @unique
  districtId                        Int
  createdAt                         DateTime                            @default(now())
  updatedAt                         DateTime
  FLAFAddressesAndContactDetails    FLAFAddressesAndContactDetails[]
  Districts                         Districts                           @relation(fields: [districtId], references: [id], onDelete: Cascade)
  RenewalAddressesAndContactDetails RenewalAddressesAndContactDetails[]
  Users                             Users[]
  Zones                             Zones[]
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  REVOKED
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ArmsCategory {
  RESTRICTED
  PERMISSIBLE
}

enum AreaOfUse {
  DISTRICT
  STATE
  INDIA
}

enum previousStatusOfLicence {
  APPROVED
  PENDING
  REJECTED
}

enum FileType {
  AADHAR_CARD
  PAN_CARD
  TRAINING_CERTIFICATE
  OTHER_STATE_LICENSE
  EXISTING_LICENSE
  SAFE_CUSTODY
  MEDICAL_REPORT
  REJECTED_LICENSE
  CLAIM_DOCS
  OTHER
  SIGNATURE_THUMB
  PHOTOGRAPH
  IRIS_SCAN
}

enum LicensePurpose {
  SELF_PROTECTION
  SPORTS
  HEIRLOOM_POLICY
  CROP_PROTECTION
}

enum LicenseResult {
  APPROVED
  REJECTED
  PENDING
}

model Licenses {
  // === IDENTIFIERS (Immutable) ===
  id                       Int              @id @default(autoincrement())
  licenseNumber            String           @unique
  almsLicenseId             String?
  issueDate                DateTime

  // === LICENSEE PERSONAL DETAILS ===
  firstName                String
  middleName               String?
  lastName                 String
  parentOrSpouseName       String
  sex                      Sex
  dateOfBirth              DateTime?
  placeOfBirth             String?
  aadharNumber             String?
  panNumber                String?

  // === LICENSE TERMS ===
  validFrom                DateTime
  validTill                DateTime
  armsCategory             ArmsCategory?
  areaOfValidity           String?
  ammunitionDescription    String?
  licencePlaceArea         String?
  specialConsiderationReason String?
  needForLicense           LicensePurpose?

  // === ADDRESS (denormalized) ===
  presentAddressLine        String?
  presentStateId           Int?
  presentDistrictId        Int?
  presentPoliceStationId   Int?
  presentZoneId            Int?
  presentDivisionId        Int?
  presentRangeOfficeId     Int?

  permanentAddressLine      String?
  permanentStateId         Int?
  permanentDistrictId      Int?
  permanentPoliceStationId Int?
  permanentZoneId          Int?
  permanentDivisionId      Int?
  permanentRangeOfficeId   Int?

  // === OCCUPATION ===
  occupation               String?
  officeAddress            String?

  // === STATUS & LIFECYCLE ===
  status                   LicenseStatus      @default(ACTIVE)
  cancellationReason       String?
  cancellationDate         DateTime?
  suspendedReason          String?
  suspendedDate            DateTime?
  lastRenewedDate          DateTime?

  // === DOCUMENTS ===
  qrCodeUrl                String?
  pdfUrl                   String?
  digitalSignature         String?
  issuedBy                 Int?

  // === APPLICATION TRACKING ===
  sourceApplicationId      Int?               @unique
  lastModifiedByAppId      Int?
  lastModifiedAppType      String?
  renewalCount             Int                @default(0)

  // === TIMESTAMPS ===
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  // === RELATIONS ===
  sourceApplication        FreshLicenseApplicationPersonalDetails? @relation("LicenseSourceFresh", fields: [sourceApplicationId], references: [id])
  issuedByUser             Users?                                  @relation("IssuedLicenses", fields: [issuedBy], references: [id])
  endorsedWeapons          WeaponTypeMaster[]                      @relation("LicenseEndorsedWeapons")
  workflowHistories        LicenseWorkflowHistory[]

  @@index([aadharNumber])
  @@index([status])
  @@index([validTill])
  @@index([firstName, lastName])
  @@index([presentStateId])
  @@index([presentDistrictId])
}

model LicenseWorkflowHistory {
  id             Int             @id @default(autoincrement())
  licenseId      Int
  action         String
  applicationId  Int?
  applicationType String?
  previousStatus LicenseStatus?
  newStatus      LicenseStatus?
  changedBy      Int?
  remarks        String?
  createdAt      DateTime        @default(now())

  license        Licenses        @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  changedByUser  Users?          @relation("LicenseWorkflowChangedBy", fields: [changedBy], references: [id])

  @@index([licenseId])
  @@index([createdAt])
}

model AuditLogs {
  id            Int      @id @default(autoincrement())
  userId        Int
  applicationId Int?
  entity        String
  entityId      String?
  action        String
  oldValue      Json?
  newValue      Json?
  ip            String?
  browser       String?
  createdAt     DateTime @default(now())

  user Users @relation("UserAuditLogs", fields: [userId], references: [id])
}

model PoliceEnquiryReports {
  id                     Int      @id @default(autoincrement())
  applicationId          Int?
  renewalId              Int?
  officerId              Int
  addressVerification    String?
  characterVerification  String?
  occupationVerification String?
  criminalVerification   String?
  threatAssessment       String?
  storageInspection      String?
  neighbourVerification  String?
  remarks                String
  recommendation         String
  attachments            Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  freshApplication   FreshLicenseApplicationPersonalDetails? @relation("FreshPoliceReports", fields: [applicationId], references: [id], onDelete: Cascade)
  renewalApplication RenewalFormPersonalDetails?             @relation("RenewalPoliceReports", fields: [renewalId], references: [id], onDelete: Cascade)
  officer            Users                                   @relation("OfficerPoliceReports", fields: [officerId], references: [id])
}

model Hearings {
  id               Int      @id @default(autoincrement())
  applicationId    Int?
  renewalId        Int?
  scheduledBy      Int
  hearingType      String
  location         String
  noticeNumber     String?
  hearingDate      DateTime
  decision         String?
  attendanceStatus String?
  remarks          String?
  documents        Json?
  status           String   @default("SCHEDULED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  freshApplication   FreshLicenseApplicationPersonalDetails? @relation("FreshHearings", fields: [applicationId], references: [id], onDelete: Cascade)
  renewalApplication RenewalFormPersonalDetails?             @relation("RenewalHearings", fields: [renewalId], references: [id], onDelete: Cascade)
  scheduler          Users                                   @relation("ScheduledHearings", fields: [scheduledBy], references: [id])
}
