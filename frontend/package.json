{
  "name": "alms-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set PORT=5000 && next dev",
    "prebuild": "powershell -Command \"if (Test-Path .next) { Remove-Item -Recurse -Force .next }\"",
    "build": "set NODE_OPTIONS=--max_old_space_size=8192 && next build",
    "build:win": "set NODE_OPTIONS=--max_old_space_size=8192 && next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "code-quality": "npm run lint && npm run format:check && npm run type-check"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.90.10",
    "@tiptap/extension-hard-break": "^3.13.0",
    "@tiptap/extension-placeholder": "^3.13.0",
    "@tiptap/extension-table": "^3.13.0",
    "@tiptap/extension-table-cell": "^3.13.0",
    "@tiptap/extension-table-row": "^3.13.0",
    "@tiptap/extension-text-align": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "cookies-next": "^6.0.0",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.17",
    "dotenv": "^16.1.4",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.525.0",
    "next": "^15.3.3",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.0.227",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-select": "^5.10.1",
    "react-toastify": "^11.0.5",
    "react-webcam": "^7.2.0",
    "recharts": "^3.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/cookie": "^0.6.0",
    "@types/date-fns": "^2.6.0",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-select": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "^30.0.2",
    "postcss": "^8.4.31",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.3"
  }
}
